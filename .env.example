# TripCraft AI - Environment Configuration Example

# Backend Settings
PROJECT_NAME="TripCraft AI"
ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (PostgreSQL Primary)
# Replace user:password@localhost:5432/tripcraft_db with your local PostgreSQL credentials
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/tripcraft_db"

# Optional Fallback for Isolated Unit Tests
# DATABASE_URL="sqlite+aiosqlite:///./test_tripcraft.db"

# Frontend Settings (Vite)
VITE_API_BASE_URL="http://localhost:8000"
